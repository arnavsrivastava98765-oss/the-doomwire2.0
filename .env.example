# DoomWire Environment Configuration Template

# Backend WebSocket & API URL (Used by Frontend)
# Default for local development: http://localhost:5000
# Production Render URL: https://your-doomwire-engine.onrender.com
VITE_BACKEND_URL=http://localhost:5000

# Backend Server Port
PORT=5000

# Rate Limiting Configuration (Optional)
MAX_SCANS_PER_WINDOW=10
MAX_CONCURRENT_SCANS=2

