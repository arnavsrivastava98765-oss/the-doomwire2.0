{
  "name": "doomwire-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"node backend/server.js\" \"vite\"",
    "dev:frontend": "vite",
    "dev:backend": "node backend/server.js",
    "build": "vite build && cd backend && npm install",
    "postinstall": "cd backend && npm install && npx playwright install chromium",
    "preview": "vite preview",
    "test": "npm run test --prefix backend",
    "start": "node backend/server.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "geoip-lite": "^1.4.10",
    "lucide-react": "^1.16.0",
    "playwright": "1.50.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-globe.gl": "^2.27.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
